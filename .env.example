# Copy to .env.local for the Next.js app. Never commit .env.local.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Local default. In the Spotify dashboard, allow this URI exactly, and also the
# production https URL, for example https://your-app.vercel.app/api/auth/callback.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Gig listings. Leave either key blank and that provider is skipped.
# The pages still render. They do not fill in sample gigs.
# Skiddle (UK events, non-commercial key): https://www.skiddle.com/api/join.php
SKIDDLE_API_KEY=
# Ticketmaster Discovery API consumer key: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# Weekly newsletter. Leave these blank and the signup form says it is not switched on.
# The pages still render. No email is sent from local development or tests.
# Postgres from the Vercel Neon integration: https://vercel.com/marketplace/neon
POSTGRES_URL=
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender, for example: Bangers & Postcodes <news@updates.example.com>
NEWSLETTER_FROM=
# Long random string. Signs preference and unsubscribe links. It is not stored.
NEWSLETTER_TOKEN_SECRET=
# Vercel Cron sends Authorization: Bearer this value. https://vercel.com/docs/cron-jobs
CRON_SECRET=
# Unlocks /newsletter/preview
NEWSLETTER_PREVIEW_SECRET=
# Absolute URL used inside emails.
SITE_URL=https://bangers-and-postcodes.vercel.app
# Optional. Defaults are 50 emails per Resend batch and 600ms between batches.
# NEWSLETTER_BATCH_SIZE=50
# NEWSLETTER_BATCH_DELAY_MS=600
# Do not set this locally. It is an explicit override that allows a real send.
# NEWSLETTER_ALLOW_SEND=
